; Plot the measured Cadence PSF result files in native ViVA strips.
; Solver provenance is recorded in each PSF header, the ADE log and popup.
let((charge discharge up upb dn dnb vop current)
  charge = "/home/shivam/Projects/VLSI/mcml_charge_pump_10ghz_project/mcml_cp_sim/verified_flow/results/viva_psf_charge"
  discharge = "/home/shivam/Projects/VLSI/mcml_charge_pump_10ghz_project/mcml_cp_sim/verified_flow/results/viva_psf_discharge"
  unless(openResults(charge)
    error("Charging PSF is unavailable; click ADE Netlist and Run first.\n")
  )
  selectResult('tran)
  up = getData("UP")
  upb = getData("UP_b")
  vop = getData("Vop")
  current = getData("I(V_VDD)")
  unless(up && upb && vop && current
    error("Charging PSF lacks a required waveform.\n")
  )
  newWindow()
  displayMode('strip)
  plot(up ?expr list("UP"))
  plot(upb ?expr list("UP_b"))
  plot(vop ?expr list("Vop (charge)"))
  plot(current ?expr list("I(V_VDD) (charge)"))
  unless(openResults(discharge)
    error("Discharging PSF is unavailable; click ADE Netlist and Run first.\n")
  )
  selectResult('tran)
  dn = getData("DN")
  dnb = getData("DN_b")
  vop = getData("Vop")
  current = getData("I(V_VDD)")
  unless(dn && dnb && vop && current
    error("Discharging PSF lacks a required waveform.\n")
  )
  newWindow()
  displayMode('strip)
  plot(dn ?expr list("DN"))
  plot(dnb ?expr list("DN_b"))
  plot(vop ?expr list("Vop (discharge)"))
  plot(current ?expr list("I(V_VDD) (discharge)"))
  printf("ViVA plotted separate charge and discharge PSF windows from Virtuoso netlist / ngspice 45.2 / FreePDK45 VTG.\n")
)
