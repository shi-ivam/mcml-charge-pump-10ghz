M_S6 Vop UP_b n_load2 Vdd PMOS_VTG W=180n L=45n NF=1 AS=16.8f AD=16.8f PS=520n PD=520n NRD=1.16667 NRS=1.16667 SA=140n SB=140n SD=160n M=1
M_M3 n_dummy UP n_load1 Vdd PMOS_VTG W=180n L=45n NF=1 AS=16.8f AD=16.8f PS=520n PD=520n NRD=1.16667 NRS=1.16667 SA=140n SB=140n SD=160n M=1
M_M2 n_load2 n_load1 Vdd Vdd PMOS_VTG W=190n L=45n NF=1 AS=16.8f AD=16.8f PS=520n PD=520n NRD=1.16667 NRS=1.16667 SA=140n SB=140n SD=160n M=1
M_M1 n_load1 n_load1 Vdd Vdd PMOS_VTG W=190n L=45n NF=1 AS=16.8f AD=16.8f PS=520n PD=520n NRD=1.16667 NRS=1.16667 SA=140n SB=140n SD=160n M=1
