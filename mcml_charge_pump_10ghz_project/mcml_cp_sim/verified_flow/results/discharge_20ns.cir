.ic V(Vop)=0.62
.options reltol=1e-3 vabstol=1e-6 iabstol=1e-12
.temp 27
.tran 0.5p 20ns 0 0.5p
.save V(Vop) V(UP) V(UP_b) V(DN) V(DN_b) V(n_tail) V(Vdd) V(Vbias) I(V_VDD)
.control
set wr_singlescale
set wr_vecnames
run
wrdata discharge_20ns.dat v(vop) v(up) v(up_b) v(dn) v(dn_b) v(n_tail) v(vdd) v(vbias) i(V_VDD)
