M_M5 n_tail Vbias 0 0 NMOS_VTG W=480n L=45n NF=1 AS=16.8f AD=16.8f PS=520n PD=520n NRD=1.16667 NRS=1.16667 SA=140n SB=140n SD=160n M=1
M_S5 Vop DN n_tail 0 NMOS_VTG W=270n L=45n NF=1 AS=16.8f AD=16.8f PS=520n PD=520n NRD=1.16667 NRS=1.16667 SA=140n SB=140n SD=160n M=1
M_M4 n_dummy DN_b n_tail 0 NMOS_VTG W=270n L=45n NF=1 AS=16.8f AD=16.8f PS=520n PD=520n NRD=1.16667 NRS=1.16667 SA=140n SB=140n SD=160n M=1
M_S3_nmos Vop DN n_bot 0 NMOS_VTG W=280n L=45n NF=1 AS=16.8f AD=16.8f PS=520n PD=520n NRD=1.16667 NRS=1.16667 SA=140n SB=140n SD=160n M=1
M_S4_nmos Vop UP n_top 0 NMOS_VTG W=280n L=45n NF=1 AS=16.8f AD=16.8f PS=520n PD=520n NRD=1.16667 NRS=1.16667 SA=140n SB=140n SD=160n M=1
M_S1 n_bot DN 0 0 NMOS_VTG W=360n L=45n NF=1 AS=16.8f AD=16.8f PS=520n PD=520n NRD=1.16667 NRS=1.16667 SA=140n SB=140n SD=160n M=1
